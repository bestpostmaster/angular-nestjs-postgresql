PORT=3002

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=app

# JWT (secret de signature, à changer en production)
JWT_SECRET=change-me

# Redis (messenger)
REDIS_HOST=localhost
REDIS_PORT=6379

# Logs (pino)
# LOG_LEVEL=debug
# LOG_DIR=logs

# development active le profiler (/_profiler) ; production le désactive
NODE_ENV=development
